ometry" /></mxCell><mxCell id="qr" value="Hiển thị QR / thời hạn thanh toán" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="520" width="240" height="55" as="geometry" /></mxCell><mxCell id="paid" value="Nhận và xác minh kết quả&#10;thanh toán từ Payment Provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="610" width="240" height="60" as="geometry" /></mxCell><mxCell id="payok" value="Thanh toán được xác minh&#10;thành công?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="710" width="160" height="90" as="geometry" /></mxCell><mxCell id="payfail" value="Đánh dấu đơn FAILED / EXPIRED;&#10;hiển thị thông báo, không phun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="720" width="270" height="65" as="geometry" /></mxCell><mxCell id="precheck" value="Kiểm tra trạng thái máy, cửa,&#10;bảo trì và lượng nước hoa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="590" y="850" width="240" height="60" as="geometry" /></mxCell><mxCell id="safe" value="Máy ONLINE, không bảo trì,&#10;cửa đóng, khe còn nước hoa?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="950" width="160" height="100" as="geometry" /></mxCell><mxCell id="stop" value="Đánh dấu REVIEW_REQUIRED;&#10;tạo cảnh báo và hướng dẫn hỗ trợ / hoàn tiền" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1000" y="960" width="300" height="70" as="geometry" /></mxCell><mxCell id="command" value="Tạo dispense command duy nhất&#10;