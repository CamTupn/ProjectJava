        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    BRANDS ||--o{ USERS : \&quot;belongs to\&quot;\n    ROLES ||--o{ USER_ROLES : \&quot;assigned to\&quot;\n    USERS ||--o{ USER_ROLES : \&quot;has\&quot;\n    BRANDS ||--o{ PRODUCTS : \&quot;manages\&quot;\n    \n    KIOSKS ||--o{ KIOSK_SLOTS : \&quot;contains\&quot;\n    PRODUCTS ||--o{ KIOSK_SLOTS : \&quot;loaded in\&quot;\n    \n    KIOSKS ||--o{ ORDERS : \&quot;placed at\&quot;\n    PRODUCTS ||--o{ ORDERS : \&quot;selected\&quot;\n    ORDERS ||--o| PAYMENTS : \&quot;paid via\&quot;\n    ORDERS ||--o| DISPENSE_COMMANDS : \&quot;triggers\&quot;\n    DISPENSE_COMMANDS ||--o| DISPENSE_EXECUTIONS : \&quot;logs outcome\&quot;\n    \n    KIOSK_SLOTS ||--o{ INVENTORY_TRANSACTIONS : \&quot;tracks volume\&quot;\n    KIOSKS ||--o{ MAINTENANCE_LOGS : \&quot;services\&quot;\n    USERS ||--o{ MAINTENANCE_LOGS : \&quot;performed by\&quot;\n    KIOSKS ||--o{ DEVICE_ALERTS : \&quot;emits\&quot;\n    USERS ||--o{ AUDIT_LOGS : \&quot;initiates\&quot;\n\n    BRANDS {\n        bigint id PK\n        varchar code UK\n        varchar name\n        varchar status\n        timestamp created_at\n    }\n\n    USERS {\n        bigint id PK\n        bigint brand_id FK\n        varchar username UK\n        varchar email UK\n        varchar password_hash\n        varchar full_name\n        varchar status\n        timestamp created_at\n    }\n\n    ROLES {\n        varchar code PK\n        varchar name\n        text description\n    }\n\n    USER_ROLES {\n        bigint user_id PK_FK\n        varchar role_code PK_FK\n    }\n\n    PRODUCTS {\n        bigint id PK\n        bigint brand_id FK\n        varchar sku UK\n        varchar name\n        decimal price\n        int volume_per_spray_ml\n        varchar status\n        timestamp created_at\n    }\n\n    KIOSKS {\n        bigint id PK\n        varchar kiosk_code UK\n        varchar name\n        varchar location_address\n        varchar connection_status\n        varchar operational_status\n        boolean door_open_sensor\n        timestamp last_ping_at\n        timestamp created_at\n    }\n\n    KIOSK_SLOTS {\n        bigint id PK\n        bigint kiosk_id FK\n        int slot_index\n        bigint current_product_id FK\n        int capacity_ml\n        int current_level_ml\n        varchar status\n        int min_threshold_ml\n        timestamp updated_at\n    }\n\n    ORDERS {\n        bigint id PK\n        varchar order_code UK\n        bigint kiosk_id FK\n        bigint product_id FK\n        bigint slot_id FK\n        decimal total_amount\n        varchar status\n        timestamp created_at\n        timestamp completed_at\n    }\n\n    PAYMENTS {\n        bigint id PK\n        bigint order_id FK_UK\n        varchar payment_ref UK\n        varchar provider\n        decimal amount\n        varchar status\n        json gateway_payload\n        timestamp paid_at\n    }\n\n    DISPENSE_COMMANDS {\n        bigint id PK\n        varchar command_token UK\n        bigint order_id FK_UK\n        bigint kiosk_id FK\n        int slot_index\n        int volume_ml\n        varchar status\n        timestamp sent_at\n    }\n\n    DISPENSE_EXECUTIONS {\n        bigint id PK\n        bigint command_id FK_UK\n        varchar execution_status\n        varchar error_code\n        json hardware_telemetry\n        timestamp recorded_at\n    }\n\n    INVENTORY_TRANSACTIONS {\n        bigint id PK\n        bigint slot_id FK\n        varchar trans_type\n        int amount_ml\n        int balance_after_ml\n        bigint reference_order_id FK\n        bigint performed_by_user_id FK\n        timestamp created_at\n    }\n\n    DEVICE_ALERTS {\n        bigint id PK\n        bigint kiosk_id FK\n        varchar severity\n        varchar alert_code\n        varchar status\n        timestamp triggered_at\n        timestamp resolved_at\n    }\n\n    MAINTENANCE_LOGS {\n        bigint id PK\n        bigint kiosk_id FK\n        bigint technician_id FK\n        varchar issue_description\n        varchar action_taken\n        varchar status\n        timestamp started_at\n        timestamp finished_at\n    }\n\n    AUDIT_LOGS {\n        bigint id PK\n        bigint user_id FK\n        varchar action\n        varchar target_entity\n        bigint target_id\n        json old_values\n        json new_values\n        varchar ip_address\n        timestamp created_at\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="IhTlgavfrX8LnTEOjmPN-1">
