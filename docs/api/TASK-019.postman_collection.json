              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machineCode\": \"SCENT-M-UNIQUE-2\",\n  \"serialNumber\": \"SCENT-SN-0001\",\n  \"deviceIdentity\": \"scent-device-unique-2\",\n  \"locationId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "9. Duplicate deviceIdentity (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machineCode\": \"SCENT-M-UNIQUE-3\",\n  \"serialNumber\": \"SCENT-SN-UNIQUE-3\",\n  \"deviceIdentity\": \"scent-device-0001\",\n  \"locationId\": 1\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Update Operational Status to MAINTENANCE",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines/{{machineId}}/status?status=MAINTENANCE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines",
                "{{machineId}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "MAINTENANCE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "11a. Update Connection Status as BRAND_ADMIN (expect 403)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines/{{machineId}}/connection-status?status=ONLINE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines",
                "{{machineId}}",
                "connection-status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ONLINE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "11b. Update Connection Status as TECHNICIAN (expect 200)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{techToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines/{{machineId}}/connection-status?status=ONLINE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines",
                "{{machineId}}",
                "connection-status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ONLINE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "12. Soft-delete machine (DISABLED)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines/{{machineId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines",
                "{{machineId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "13. Verify machine is DISABLED",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/machines/{{machineId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "machines",
                "{{machineId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Operational status is DISABLED', () => pm.expect(pm.response.json().operationalStatus).to.eql('DISABLED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "14. Access machine of other tenant (expect 404)",
          "request": {
            "method": "GET",
            "header": [
              {
